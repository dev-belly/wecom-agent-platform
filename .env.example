# 企微配置（复制为 .env 填写真实值）
VLLM_BASE_URL=http://localhost:8000
LLM_MODEL=Qwen/Qwen3-14B-AWQ
LLM_TEMPERATURE=0.1

EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

CHROMA_PERSIST_DIR=./data/vectors
PDF_INPUT_DIR=./data/pdfs
PARSED_OUTPUT_DIR=./data/parsed
EVAL_DATA_DIR=./data/eval

# 生产环境必须设置；本地 development 留空时可直接调试。
ENV=development
API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

WECOM_CORP_ID=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=

DEBUG=true
